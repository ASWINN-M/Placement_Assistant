# Copy to Backend/.env (never commit)

GROQ_API_KEY=your_groq_key_here

# Supabase pooler URI (encode @ in password as %40)
# DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Local Docker Postgres (optional)
# DATABASE_URL=postgresql+psycopg2://placement:placement@127.0.0.1:5433/placement
